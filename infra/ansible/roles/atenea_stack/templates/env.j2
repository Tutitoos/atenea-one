{% for key, value in atenea_stack_environment | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% for service, variable in [('control-plane', 'CONTROL_PLANE_IMAGE'), ('coordinator', 'COORDINATOR_IMAGE'), ('relay', 'RELAY_IMAGE')] %}
{% if service in atenea_stack_images %}
{{ variable }}={{ atenea_stack_images[service] }}
{% endif %}
{% endfor %}
{% if 'stun' in atenea_stack_images %}
COORDINATOR_IMAGE={{ atenea_stack_images['stun'] }}
{% endif %}
