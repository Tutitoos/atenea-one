# Generar una vez 16 bytes con RNG del SO; persistir el mismo ID en la entrada del coordinator.
# Exactamente 32 hex minúsculos no cero; distinto del principal y de cualquier otro relay.
# No regenerar al arrancar, converger Ansible o rotar TLS. ALPN exclusivo: atenea-relay/2.
relay_id = "REEMPLAZAR_POR_32_HEX_MINUSCULOS_NO_CERO"
udp_listen = "0.0.0.0:443"
tcp_listen = "0.0.0.0:443"
proxy_protocol = false
coordinator_keys = ["REEMPLAZAR_POR_CLAVE_PUBLICA_COORDINATOR_HEX"]
tls_cert_file = "/etc/atenea/relay.pem"
tls_key_file = "/run/secrets/relay.key"
status_socket = "/tmp/relay.sock"
