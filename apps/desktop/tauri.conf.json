{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atenea One",
  "version": "0.1.0",
  "identifier": "one.atenea.desktop",
  "build": { "frontendDist": "./build/client" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Atenea One", "width": 920, "height": 600, "minWidth": 760, "minHeight": 460, "visible": false }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
