import { FAQ } from "../../faq.mjs";
---

<div class="max-w-3xl divide-y divide-rule border-y border-rule">
  {
    FAQ.map((item) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-baseline gap-3 font-mono text-sm text-gray-100 marker:hidden [&::-webkit-details-marker]:hidden">
          <span class="text-xs text-gray-400 group-open:hidden" aria-hidden="true">+</span>
          <span class="hidden text-xs text-gray-400 group-open:inline" aria-hidden="true">−</span>
          {item.question}
        </summary>
        <p class="mt-3 max-w-[68ch] pl-5 text-sm leading-6 text-gray-300">{item.answer}</p>
      </details>
    ))
  }
</div>
