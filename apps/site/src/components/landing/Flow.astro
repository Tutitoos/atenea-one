import SubHead from "./SubHead.astro";

// El diagrama es SVG en línea y solo usa tokens del tema, así que sigue la
// paleta sin un literal de color. Lleva una lista ordenada al lado: es el texto
// alternativo completo para quien no ve el dibujo, y lo que se lee en una
// pantalla estrecha donde el SVG se desplaza en horizontal.
const steps = [
  {
    title: "Configuración firmada",
    text: "El control plane firma la configuración de cada dispositivo: sus pares, rutas aprobadas y política, con un lease de vigencia limitada.",
  },
  {
    title: "Anuncio y rendezvous",
    text: "Cada agente se anuncia al coordinator, que solo da pistas de endpoint sin autenticar y ayuda a atravesar NAT con STUN.",
  },
  {
    title: "Camino directo",
    text: "Los agentes intentan hole punching y negocian una sesión Noise IK: cifrado de extremo a extremo y sin intermediarios.",
  },
  {
    title: "Relay como respaldo",
    text: "Si no hay camino directo, el tráfico va por un relay UDP o, si la red bloquea UDP, por TLS sobre el puerto 443. El relay solo ve datagramas cifrados.",
  },
];
---

<div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
  <figure class="min-w-0">
    <div class="overflow-x-auto border border-rule bg-panel p-4">
      <svg
        viewBox="0 0 960 560"
        class="mx-auto block h-auto w-full min-w-[40rem]"
        role="img"
        aria-labelledby="flow-title flow-desc"
        font-family="var(--font-mono)"
        font-size="13"
      >
        <title id="flow-title">Cómo se conectan dos dispositivos</title>
        <desc id="flow-desc">
          El control plane firma la configuración de los agentes A y B. Ambos se
          anuncian al coordinator. Después se conectan por un camino directo
          cifrado; si no es posible, usan un relay.
        </desc>

        <defs>
          <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 10 5 0 10z" style="fill: var(--color-gray-400)" />
          </marker>
          <marker id="flow-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M0 0 10 5 0 10z" style="fill: var(--color-graph-exact)" />
          </marker>
        </defs>

        <g style="fill: none; stroke: var(--color-gray-400); stroke-width: 1.5">
          <path d="M370 52 C150 52 150 250 150 330" marker-end="url(#flow-arrow)" />
          <path d="M590 52 C810 52 810 250 810 330" marker-end="url(#flow-arrow)" />
          <path d="M210 330 C210 270 320 208 370 204" marker-start="url(#flow-arrow)" marker-end="url(#flow-arrow)" stroke-dasharray="2 5" />
          <path d="M750 330 C750 270 640 208 590 204" marker-start="url(#flow-arrow)" marker-end="url(#flow-arrow)" stroke-dasharray="2 5" />
        </g>
        <path
          d="M260 366 L700 366"
          style="fill: none; stroke: var(--color-graph-exact); stroke-width: 3"
          marker-start="url(#flow-arrow-accent)"
          marker-end="url(#flow-arrow-accent)"
        />
        <g style="fill: none; stroke: var(--color-accent-200); stroke-width: 1.5" stroke-dasharray="8 6">
          <path d="M200 402 C200 490 300 490 370 490" marker-end="url(#flow-arrow)" />
          <path d="M590 490 C660 490 760 490 760 402" marker-end="url(#flow-arrow)" />
        </g>

        <g style="fill: var(--color-panel); stroke: var(--color-rule-strong); stroke-width: 1">
          <rect x="370" y="20" width="220" height="64" />
          <rect x="370" y="172" width="220" height="64" />
          <rect x="40" y="330" width="220" height="72" />
          <rect x="700" y="330" width="220" height="72" />
          <rect x="370" y="458" width="220" height="64" />
        </g>

        <g style="fill: var(--color-gray-100)" text-anchor="middle" font-weight="500">
          <text x="480" y="50">control plane</text>
          <text x="480" y="202">coordinator + STUN</text>
          <text x="150" y="362">agente A</text>
          <text x="810" y="362">agente B</text>
          <text x="480" y="488">relay</text>
        </g>
        <g style="fill: var(--color-gray-400)" text-anchor="middle" font-size="11">
          <text x="480" y="70">panel · emisor · leases</text>
          <text x="480" y="222">solo pistas sin autenticar</text>
          <text x="150" y="384">túnel atenea0</text>
          <text x="810" y="384">túnel atenea0</text>
          <text x="480" y="508">no confiable · no lee el tráfico</text>
        </g>

        <g style="fill: var(--color-gray-300)" font-size="12">
          <text x="134" y="190" text-anchor="end">① config firmada</text>
          <text x="134" y="206" text-anchor="end">+ lease</text>
          <text x="826" y="190">① config firmada</text>
          <text x="826" y="206">+ lease</text>
          <text x="196" y="262" text-anchor="end">② anuncio y rendezvous</text>
          <text x="764" y="262">② anuncio y rendezvous</text>
        </g>
        <text x="480" y="348" text-anchor="middle" font-size="12" style="fill: var(--color-graph-exact)">③ camino directo · Noise IK de extremo a extremo</text>
        <text x="480" y="548" text-anchor="middle" font-size="12" style="fill: var(--color-accent-200)">④ sin camino directo: relay UDP o TLS/443, datagramas cifrados</text>
      </svg>
    </div>
    <figcaption class="mt-3 max-w-[68ch] text-xs leading-5 text-gray-400">
      Línea continua: tráfico cifrado de extremo a extremo. Discontinua: señalización
      y respaldo por relay.
    </figcaption>
  </figure>

  <ol class="space-y-5">
    {
      steps.map((step, index) => (
        <li>
          <SubHead title={step.title} marker={String(index + 1).padStart(2, "0")} />
          <p class="mt-3 max-w-[68ch] text-sm leading-6 text-gray-300">{step.text}</p>
        </li>
      ))
    }
  </ol>
</div>
