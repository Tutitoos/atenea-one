import { COLUMNS, LEGEND, SUMMARY } from "../../comparison.mjs";
import Status from "./Status.astro";
---

<div class="space-y-6">
  <p class="max-w-[68ch] text-sm leading-6 text-gray-300">
    La diferencia que reivindica Atenea One es una: ninguna pieza de coordinación
    ni de relay depende de un tercero. Aquí está en una tabla; la comparación
    técnica completa, con cada fuente, está en la documentación. <strong
      class="font-medium text-gray-100">No hay medición cara a cara</strong
    >: es una comparación de cómo está construido cada sistema, no de cuánto rinde.
  </p>

  <div class="overflow-x-auto border border-rule">
    <table class="w-full min-w-[36rem] border-collapse text-left">
      <caption class="sr-only">
        Resumen de la comparación entre Atenea One, Tailscale y ZeroTier
      </caption>
      <thead>
        <tr class="border-b border-rule bg-panel font-mono text-xs text-gray-400">
          <th scope="col" class="px-5 py-4 font-normal">
            <span class="sr-only">decisión técnica</span>
          </th>
          {
            COLUMNS.map((column, index) => (
              <th
                scope="col"
                class:list={[
                  "w-[17%] px-4 py-4 text-center font-normal",
                  index === 0 && "text-graph-exact",
                ]}
              >
                {column}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          SUMMARY.map((row) => (
            <tr class="border-b border-rule last:border-b-0">
              <th
                scope="row"
                class="px-5 py-4 text-sm leading-5 font-medium text-gray-100"
              >
                {row.topic}
              </th>
              {row.cells.map((status) => (
                <td class="px-4 py-4 text-center text-xs">
                  <Status status={status} />
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="max-w-[68ch] text-xs leading-5 text-gray-400">
    <strong class="font-medium text-gray-300">Rendezvous</strong>: el paso en el
    que dos dispositivos detrás de NAT se encuentran. Un tercero con IP pública
    les pasa las direcciones candidatas del otro, y los dos envían paquetes a la
    vez (hole punching) para abrir un camino directo. En Atenea One lo hace el
    coordinator, que solo da pistas sin autenticar: el túnel lo crea únicamente
    un handshake válido.
  </p>

  <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-gray-400">
    {
      LEGEND.map((item) => (
        <li class="flex items-center gap-2">
          <Status status={item.status} label="" />
          {item.text}
        </li>
      ))
    }
  </ul>

  <p class="text-xs">
    <a
      href="/comparacion/"
      class="font-mono text-accent-200 underline underline-offset-4"
      >comparación técnica completa y fuentes</a
    >
  </p>
</div>
