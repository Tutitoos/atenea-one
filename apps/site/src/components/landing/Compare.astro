import { FIT, NOTES, OPERATORS } from "../../comparison.mjs";
import CompareTable from "./CompareTable.astro";
import SubHead from "./SubHead.astro";
---

<div class="space-y-10">
  <p class="max-w-[68ch] text-sm leading-6 text-gray-300">
    La alternativa a Atenea One no es que otros productos funcionen mal: es
    depender de quien opera la coordinación. Esta es la comparación técnica de
    cómo está construido cada sistema, fila a fila y con su fuente. <strong
      class="font-medium text-gray-100">No hay medición cara a cara</strong
    >, así que aquí no hay una sola cifra de rendimiento de Tailscale o ZeroTier.
  </p>

  <div>
    <p class="font-mono text-xs text-gray-400">quién opera la coordinación</p>
    <dl class="mt-3 grid grid-cols-1 gap-10 sm:grid-cols-3">
      {
        OPERATORS.map((operator) => (
          <div>
            <dd
              class:list={[
                "font-mono text-3xl font-medium tracking-tight",
                operator.highlight ? "text-graph-exact" : "text-gray-100",
              ]}
            >
              {operator.value}
            </dd>
            <dt class="mt-2 text-xs text-gray-300">{operator.name}</dt>
            <p class="mt-1 max-w-[34ch] text-xs leading-5 text-gray-400">
              {operator.detail}
            </p>
          </div>
        ))
      }
    </dl>
  </div>

  <CompareTable />

  <div>
    <SubHead title="cuándo encaja cada uno" />
    <div class="mt-5 grid grid-cols-1 gap-px border border-rule bg-rule md:grid-cols-3">
      {
        FIT.map((item) => (
          <div class="bg-panel p-5">
            <p
              class:list={[
                "font-mono text-sm",
                item.highlight ? "text-graph-exact" : "text-gray-100",
              ]}
            >
              {item.name}
            </p>
            <ul class="mt-3 space-y-2 text-xs leading-5 text-gray-300">
              {item.points.map((point) => (
                <li class="flex gap-2">
                  <span class="text-gray-400" aria-hidden="true">
                    ·
                  </span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <ol class="divide-y divide-rule border-y border-rule text-sm leading-6 text-gray-300">
    {
      NOTES.map((note, index) => (
        <li class="flex gap-3 py-4">
          <span class="font-mono text-xs leading-6 text-graph-exact" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="max-w-[90ch]">{note}</span>
        </li>
      ))
    }
  </ol>
</div>
