import { defs } from "./diagram";

// El marco de un diagrama de la documentación: el recuadro, el SVG con sus
// flechas, el botón de ampliar y el pie. El contenido llega por el `<slot>` ya
// como SVG. `not-content` saca el bloque de la tipografía de Starlight, que si no
// le pondría márgenes a cada `<text>`. El texto alternativo es `description`: un
// diagrama sin él no dice nada a un lector de pantalla, así que es obligatorio.
interface Props {
  title: string;
  description: string;
  viewBox: string;
  /** Ancho mínimo en rem; por debajo, el SVG se desplaza en horizontal. */
  minWidth?: number;
}

const { title, description, viewBox, minWidth = 44 } = Astro.props;
---

<figure class="not-content relative my-8 min-w-0" data-diagram>
  <div class="relative">
    <div class="overflow-x-auto border border-rule bg-panel p-4">
      <svg
        viewBox={viewBox}
        class="mx-auto block h-auto w-full"
        style={`min-width: ${minWidth}rem`}
        role="img"
        aria-label={`${title}. ${description}`}
        data-diagram-svg
        data-diagram-title={title}
        font-family="var(--font-mono)"
        font-size="13"
      >
        <defs set:html={defs} />
        <slot />
      </svg>
    </div>
    <button
      type="button"
      data-diagram-open
      class="absolute top-2 right-2 flex items-center gap-2 border border-rule-strong bg-raise px-2.5 py-1 font-mono text-xs text-gray-300 transition-colors hover:border-gray-500 hover:text-gray-100"
    >
      <svg
        viewBox="0 0 16 16"
        class="size-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" />
      </svg>
      ampliar
      <span class="sr-only">el diagrama</span>
    </button>
  </div>
  <figcaption class="mt-3 max-w-[72ch] text-xs leading-5 text-gray-400">
    <slot name="caption" />
  </figcaption>
</figure>

<script>
  // Un solo diálogo por página, creado la primera vez que hace falta. El SVG que
  // se muestra es una copia: el de la página no se mueve.
  let dialog: HTMLDialogElement | null = null;
  let body: HTMLElement | null = null;
  let heading: HTMLElement | null = null;

  function ensureDialog() {
    if (dialog && body && heading) return { dialog, body, heading };
    const created = document.createElement("dialog");
    created.className =
      "m-auto max-h-[94vh] w-[min(96vw,1500px)] max-w-none overflow-hidden border border-rule-strong bg-panel p-0 text-gray-100 backdrop:bg-black/85";
    created.innerHTML =
      '<div class="flex items-center justify-between border-b border-rule px-4 py-3 font-mono text-xs text-gray-400"><span data-diagram-heading></span><button type="button" data-diagram-close class="border border-rule-strong bg-raise px-3 py-1 text-gray-300 transition-colors hover:text-gray-100">cerrar</button></div><div data-diagram-body class="max-h-[calc(94vh-3.25rem)] overflow-auto p-4"></div>';
    document.body.appendChild(created);
    dialog = created;
    body = created.querySelector<HTMLElement>("[data-diagram-body]");
    heading = created.querySelector<HTMLElement>("[data-diagram-heading]");
    created.querySelector("[data-diagram-close]")?.addEventListener("click", () => created.close());
    // Un clic en el fondo oscuro, fuera del cuadro, cierra el diálogo.
    created.addEventListener("click", (event) => {
      if (event.target === created) created.close();
    });
    created.addEventListener("close", () => body?.replaceChildren());
    return { dialog: created, body: body as HTMLElement, heading: heading as HTMLElement };
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-diagram-open]")) {
    button.addEventListener("click", () => {
      const source = button.closest("figure")?.querySelector<SVGSVGElement>("[data-diagram-svg]");
      if (!source) return;
      const target = ensureDialog();
      const copy = source.cloneNode(true) as SVGSVGElement;
      copy.removeAttribute("data-diagram-svg");
      copy.setAttribute("aria-hidden", "true");
      copy.style.minWidth = "56rem";
      // Que quepa entera sin desplazar: el alto disponible fija el ancho máximo.
      const box = source.viewBox.baseVal;
      const availableHeight = window.innerHeight * 0.94 - 110;
      copy.style.maxWidth = `${(availableHeight * box.width) / box.height}px`;
      target.heading.textContent = source.dataset.diagramTitle ?? "";
      target.body.replaceChildren(copy);
      target.dialog.setAttribute("aria-label", `${source.dataset.diagramTitle ?? "Diagrama"}, ampliado`);
      target.dialog.showModal();
    });
  }
</script>
