import DiagramFrame from "./DiagramFrame.astro";
import { arrow, box, label, zone } from "./diagram";

// ADR-007: un router Linux sirve una subred privada a otros dispositivos.
// Direcciones de documentación sintéticas.
const shapes = [
  zone(16, 16, 250, 250, "red local detrás del router"),
  box(36, 60, 210, 52, "vm-web", "192.168.10.20"),
  box(36, 132, 210, 52, "vm-db", "192.168.10.30"),
  label(141, 224, "192.168.10.0/24", { size: 11.5 }),

  box(340, 100, 220, 96, "router de subred", "Linux · agente atenea", "gold"),
  box(700, 100, 220, 96, "cliente", "macOS o Windows · solo consume", "ok"),

  arrow("M246 86 L338 130"),
  arrow("M246 158 L338 166"),
  arrow("M562 148 L698 148", "gold", { both: true, width: 2.5 }),
  label(630, 138, "túnel", { tone: "gold", size: 11 }),

  label(450, 232, "ruta aprobada por un administrador", { size: 11 }),
  label(450, 250, "snat elegido por ruta, sin valor por defecto", { size: 11 }),
  label(810, 232, "instala la ruta 192.168.10.0/24", { size: 11 }),
  label(810, 250, "si no choca con otra de su red local", { size: 11 }),
].join("");
---

<DiagramFrame
  title="Router de subred"
  description="Un router Linux con una ruta aprobada sirve la red 192.168.10.0/24 a un cliente de macOS o Windows a través del túnel. El cliente instala la ruta solo si no choca con una de su red local."
  viewBox="0 0 960 284"
  minWidth={38}
>
  <Fragment set:html={shapes} />
  <Fragment slot="caption">
    Solo prefijos privados, nunca la ruta por defecto: no hay exit node. Con
    snat activo los equipos de la red local ven la IP del router; sin él, ven la IP
    de túnel del cliente y necesitan una ruta de retorno hacia la red del túnel.
  </Fragment>
</DiagramFrame>
