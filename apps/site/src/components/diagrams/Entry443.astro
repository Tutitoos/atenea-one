import DiagramFrame from "./DiagramFrame.astro";
import { arrow, box, label } from "./diagram";

// ADR-004: una sola entrada TCP 443 que enruta por SNI y ALPN sin terminar TLS.
const shapes = [
  box(16, 130, 150, 70, "cliente", "navegador o agente"),
  box(230, 130, 190, 70, "HAProxy", "modo tcp · no descifra", "gold"),
  box(560, 50, 220, 76, "relay", "127.0.0.1:8443 · rustls", "relay"),
  box(560, 204, 220, 76, "Caddy", "TLS · panel y API"),

  arrow("M168 165 L228 165"),
  label(198, 153, "TCP 443", { size: 11 }),

  arrow("M422 150 C 490 150 490 88 558 88", "relay"),
  label(670, 38, "SNI del relay y ALPN atenea-relay/2", {
    tone: "relay",
    size: 11,
  }),
  arrow("M422 180 C 490 180 490 242 558 242"),
  label(670, 300, "cualquier otra cosa, incluido ALPN /1", { size: 11 }),

  box(810, 50, 134, 76, "agente", "relay TLS", "relay"),
  box(810, 204, 134, 76, "administrador", "panel web"),
  arrow("M782 88 L808 88", "relay", { both: true }),
  arrow("M782 242 L808 242", "plain", { both: true }),

  label(
    480,
    336,
    "PROXY protocol v2 solo hacia el relay, y solo se acepta desde loopback",
    { size: 11 },
  ),
].join("");
---

<DiagramFrame
  title="Entrada TCP 443 compartida"
  description="HAProxy escucha en TCP 443 en modo tcp, sin terminar TLS. Si el SNI es el del relay y el ALPN es atenea-relay/2, reenvía al relay en loopback. Todo lo demás va a Caddy, que sirve el panel, la API y el coordinator."
  viewBox="0 0 960 356"
  minWidth={44}
>
  <Fragment set:html={shapes} />
  <Fragment slot="caption">
    Los puertos UDP 443 (relay) y UDP 3478 y 3479 (STUN) no pasan por HAProxy: los
    atiende directamente cada servicio. TCP 80 queda para el desafío ACME de Caddy.
  </Fragment>
</DiagramFrame>
