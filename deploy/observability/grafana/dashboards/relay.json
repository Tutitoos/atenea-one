{
  "uid": "atenea-relay",
  "title": "Atenea · relay",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilidad",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"relay\"}",
          "legendFormat": "{{code}} {{route}} {{transport}} {{direction}} {{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sesiones UDP/TLS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"atenea_relay_(udp|tls)_sessions\"}",
          "legendFormat": "{{code}} {{route}} {{transport}} {{direction}} {{reason}}"
        }
      ]
    },
    {
